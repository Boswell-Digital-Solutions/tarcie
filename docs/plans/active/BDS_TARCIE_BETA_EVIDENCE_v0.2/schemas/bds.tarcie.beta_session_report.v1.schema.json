{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswelldigitalsolutions.com/tarcie/beta-session-report.v1.schema.json",
  "title": "BetaSessionReport.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report_revision", "report_state", "session_id", "assignment_id", "product_id", "build_id", "tester_id", "platform", "started_at", "ended_at", "section_coverage", "findings", "overall_experience", "privacy_review_complete", "tester_attestation", "pdf_field_map_version", "structured_report_sha256", "generated_pdf_sha256"],
  "properties": {
    "schema_version": {"const": "BetaSessionReport.v1"},
    "report_id": {"type": "string", "format": "uuid"},
    "report_revision": {"type": "integer", "minimum": 1},
    "report_state": {"enum": ["reviewing", "finalized"]},
    "session_id": {"type": "string", "format": "uuid"},
    "assignment_id": {"type": "string", "format": "uuid"},
    "product_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "build_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tester_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "tester_display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "platform": {"enum": ["windows", "macos", "linux"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "section_coverage": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section_id", "state", "comment", "observation_ids"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "state": {"enum": ["not_started", "in_progress", "reviewed", "partial", "blocked", "skipped", "not_applicable"]},
          "comment": {"type": "string", "maxLength": 5000},
          "observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
        }
      }
    },
    "findings": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "expected", "observed", "reproduction_steps", "blocking_issue", "evidence_references"],
        "properties": {
          "finding_id": {"type": "string", "format": "uuid"},
          "expected": {"type": "string", "maxLength": 4000},
          "observed": {"type": "string", "minLength": 1, "maxLength": 4000},
          "reproduction_steps": {"type": "string", "maxLength": 6000},
          "blocking_issue": {"type": "boolean"},
          "evidence_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
        }
      }
    },
    "overall_experience": {"type": "string", "minLength": 1, "maxLength": 10000},
    "unresolved_work": {"type": "string", "maxLength": 10000},
    "privacy_review_complete": {"const": true},
    "tester_attestation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "pdf_field_map_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "structured_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
